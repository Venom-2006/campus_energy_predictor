import pandas as pd

# Path to the large uncompressed train.csv you downloaded from Kaggle
large_train_file = "train.csv"
output_small_file = "train_education_site1.csv"

# Building 105 is an Education facility under site_id 1 with clean hourly data
target_building_id = 105

print("Filtering large train.csv in chunks...")
chunks = []

# Process in chunks of 500,000 rows to keep RAM usage low
for chunk in pd.read_csv(large_train_file, chunksize=500_000):
    filtered = chunk[(chunk["building_id"] == target_building_id) & (chunk["meter"] == 0)]
    if not filtered.empty:
        chunks.append(filtered)

if chunks:
    df_small = pd.concat(chunks, ignore_index=True)
    df_small.to_csv(output_small_file, index=False)
    print(f"Done! Created '{output_small_file}' with {len(df_small):,} rows.")
    print("This file is under 500 KB and can be uploaded instantly.")
else:
    print(f"No records found for building_id {target_building_id}.")